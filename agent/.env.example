# Copy this file to .env and fill in ONE of the blocks below.
# NEVER commit .env — add it to .gitignore first.
#
# Every option here is FREE. They all speak the OpenAI protocol, so switching
# provider is a config change only — llm.py does not change.

# ---------------------------------------------------------------------------
# OPTION 1 — Google AI Studio (Gemini).  Free, no credit card.
# Usually the most generous free quota. Check YOUR limits at:
#   https://aistudio.google.com/rate-limit
# Get a key at: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
<<<<<<< HEAD
